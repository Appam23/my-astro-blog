---
import Layout from '../layouts/Layout.astro';

const posts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
posts.sort((a, b) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf());
const latestPosts = posts.slice(0, 3);
---

<Layout title="My Astro Blog">
  <main>
    <h1>Welcome to Appam's Astro Blog</h1>
    <p>I’m learning how to build websites with Astro and documenting the journey.</p>

    <section>
      <h2>Latest Posts</h2>
      <ul>
        {latestPosts.map((post) => (
          <li>
            <a href={post.url}>{post.frontmatter.title}</a>
            <p>{post.frontmatter.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
