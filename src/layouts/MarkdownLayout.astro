---
import '../styles/global.css';
const { frontmatter } = Astro.props;
const publishedDate = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title}</title>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/about/">About</a>
      <a href="/blog/">Blog</a>
    </nav>

    <article>
      <h1>{frontmatter.title}</h1>
      <p>Written by {frontmatter.author} on {publishedDate}</p>
      <slot />
    </article>
  </body>
</html>