---
const { title, author, pubDate } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article>
  <h1>{title}</h1>
  <p>Written by {author} on {formattedDate}</p>
  <slot />
</article>